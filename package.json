{
  "name": "dawnwalker-guide",
  "version": "0.1.0",
  "description": "Guide, database and run planner for The Blood of Dawnwalker",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=6000\" next dev",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "devsafe": "pnpm run clean && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=6000\" next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=6000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "typecheck": "tsc --noEmit",
    "check:css": "node tools/check-css.mjs",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run check:css && pnpm run test && pnpm run build",
    "test:watch": "vitest",
    "seed": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/run.ts",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "assets": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/assets.ts",
    "assets:match": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/match-assets.ts",
    "ingest": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/import.ts",
    "clean:db": "node tools/reset-db.mjs",
    "db:reset": "pnpm run clean:db && pnpm run seed && pnpm run ingest && pnpm run seed:games && pnpm run seed:entities && pnpm run seed:guides && pnpm run seed:articles && pnpm run assets && pnpm run seed:art && pnpm run seed:avatars",
    "indexnow": "cross-env NODE_OPTIONS=--no-deprecation node tools/indexnow.mjs",
    "verify": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/verify.ts",
    "seed:games": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/game-content.ts",
    "fetch:games": "node tools/fetch-game-data.mjs",
    "seed:art": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/game-art.ts && cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/dawnwalker-art.ts",
    "seed:avatars": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/avatars.ts",
    "make:avatars": "node tools/make-avatars.mjs",
    "fetch:entities": "node tools/fetch-wiki-entities.mjs",
    "seed:entities": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/wiki-entities.ts",
    "check:launch": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/audit.ts",
    "refresh": "pnpm run fetch:games && pnpm run harvest:all && pnpm run seed:games && pnpm run seed:entities && pnpm run seed:guides && pnpm run seed:art && node tools/make-wiki-icons.mjs",
    "seed:guides": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/game-guides.ts",
    "harvest:all": "node tools/harvest-all.mjs",
    "fetch:queries": "node tools/fetch-search-queries.mjs",
    "seed:articles": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/query-articles.ts"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@payloadcms/ui": "3.89.0",
    "cross-env": "10.1.0",
    "graphql": "^16.8.1",
    "next": "16.3.5",
    "payload": "3.89.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.34.2"
  },
  "devDependencies": {
    "@types/node": "24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dotenv": "16.4.7",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "4.1.6"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver",
      "sqlite3",
      "better-sqlite3",
      "@libsql/client"
    ]
  },
  "packageManager": "pnpm@10.33.0"
}
