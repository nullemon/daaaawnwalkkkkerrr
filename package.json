{
  "name": "dawnwalker-guide",
  "version": "0.1.0",
  "description": "Guide, database and run planner for The Blood of Dawnwalker",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=6000\" next dev",
    "clean": "node -e \"require('fs').rmSync('.next',{recursive:true,force:true})\"",
    "devsafe": "pnpm run clean && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=6000\" next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=6000\" next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "typecheck": "tsc --noEmit",
    "check:css": "node tools/check-css.mjs",
    "test": "vitest run",
    "check": "pnpm run typecheck && pnpm run check:css && pnpm run test && pnpm run build",
    "test:watch": "vitest",
    "seed": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/run.ts",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "assets": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/assets.ts",
    "assets:match": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/match-assets.ts",
    "ingest": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/import.ts",
    "clean:db": "node tools/reset-db.mjs",
    "db:reset": "pnpm run clean:db && pnpm run seed && pnpm run ingest && pnpm run seed:games && pnpm run seed:reference && pnpm run seed:game-profile && pnpm run seed:entities && pnpm run seed:prune-entities && pnpm run seed:companies && pnpm run seed:guides && pnpm run seed:articles && pnpm run seed:deep && pnpm run seed:topics && pnpm run assets && pnpm run seed:art && pnpm run seed:contributors && pnpm run seed:avatars && pnpm run seed:prune && pnpm run seed:cite && pnpm run seed:guide-images && pnpm run seed:publish",
    "indexnow": "cross-env NODE_OPTIONS=--no-deprecation node tools/indexnow.mjs",
    "verify": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/verify.ts",
    "seed:games": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/game-content.ts",
    "fetch:games": "node tools/fetch-game-data.mjs",
    "seed:art": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/game-art.ts && cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/dawnwalker-art.ts",
    "seed:avatars": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/avatars.ts",
    "make:avatars": "node tools/make-avatars.mjs",
    "fetch:entities": "node tools/fetch-wiki-entities.mjs",
    "seed:entities": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/wiki-entities.ts",
    "check:launch": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/audit.ts",
    "refresh": "pnpm run fetch:games && pnpm run fetch:reference && pnpm run harvest:all && pnpm run fetch:queries && pnpm run seed:games && pnpm run seed:reference && pnpm run seed:entities && pnpm run seed:guides && pnpm run seed:articles && pnpm run seed:deep && pnpm run seed:art && node tools/make-wiki-icons.mjs",
    "seed:guides": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/game-guides.ts",
    "harvest:all": "node tools/harvest-all.mjs",
    "fetch:queries": "node tools/fetch-search-queries.mjs",
    "seed:articles": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/query-articles.ts",
    "fetch:reference": "node tools/fetch-reference-facts.mjs",
    "seed:reference": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/reference-facts.ts",
    "remote": "node tools/remote.mjs",
    "seed:deep": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/deep-guides.ts",
    "seed:topics": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/topic-guides.ts",
    "seed:cite": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/cite-compilations.ts",
    "seed:prune": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/prune-guides.ts",
    "seed:publish": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/publish-guides.ts",
    "seed:guide-images": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/guide-images.ts",
    "make:tiles": "node tools/make-tile-art.mjs",
    "seed:prune-entities": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/prune-entities.ts",
    "seed:companies": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/companies.ts",
    "seed:prune-media": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/prune-media.ts",
    "check:kind": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/check-kind.ts",
    "fetch:companies": "node tools/fetch-companies.mjs",
    "seed:contributors": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/contributors.ts",
    "seed:game-profile": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" tsx src/seed/game-profile.ts"
  },
  "dependencies": {
    "@payloadcms/db-sqlite": "3.89.0",
    "@payloadcms/next": "3.89.0",
    "@payloadcms/richtext-lexical": "3.89.0",
    "@payloadcms/ui": "3.89.0",
    "cross-env": "10.1.0",
    "graphql": "^16.8.1",
    "next": "16.3.5",
    "payload": "3.89.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "0.34.2"
  },
  "devDependencies": {
    "@types/node": "24.12.3",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "dotenv": "16.4.7",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "vitest": "4.1.6"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver",
      "sqlite3",
      "better-sqlite3",
      "@libsql/client"
    ]
  },
  "packageManager": "pnpm@10.33.0"
}
