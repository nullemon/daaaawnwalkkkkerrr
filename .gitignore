node_modules/
.next/
*.tsbuildinfo
build/
dist/
*.log
npm-debug.log*

.env
.env.*
!.env.example

# local sqlite database + uploaded media
*.db
*.db-journal
*.db-wal
*.db-shm
# Media has no staticDir set, so Payload writes uploads and their generated
# sizes to ./media at the repo root — public/media/ alone never matched a file
# and only looked right until something was actually uploaded.
/media/
public/media/

.DS_Store
*.pem
.vercel

# The remote-control device key and the token of whatever session is open.
# Both are credentials for a live site; the key is generated per machine and is
# meant to stay on it, and a committed one would be a device nobody can revoke
# because nobody knows who has it. `tools/remote.mjs` writes both.
/.remote/
.idea/
.vscode/

# Game assets are large and not ours to redistribute — keep them out of git.
# The folder and its README stay; the image files do not.
assets/**
!assets/README.md

# Throwaway screenshots from checking a page during development.
# They are worth nothing once the change is verified, and a stray `git add -A`
# will otherwise commit several megabytes of them.
s-*.png
shot-*.png

# Scratch scripts written while investigating. One got committed once; a
# pattern is cheaper than remembering.
/.scratch-*
/.bughunt-*
/.tmp-*
