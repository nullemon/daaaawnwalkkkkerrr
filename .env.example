# Local dev uses an on-disk SQLite file. No account or external service needed.
DATABASE_URI=file:./dawnwalker.db
# For production on Turso/libSQL, swap to the remote URL and set the auth token:
# DATABASE_URI=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=CHANGE_ME

# Public origin, used for canonical URLs, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# IndexNow pushes new and changed URLs to Bing, Yandex, Seznam, Naver and Yep.
# Google does not participate — for Google, submit the sitemap in Search Console.
#
# A key is already generated and committed as public/<key>.txt. Nothing to set
# up: just deploy, then run `pnpm indexnow --send`. This variable only exists to
# override that key if it is ever rotated.
# INDEXNOW_KEY=
