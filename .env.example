# Local dev uses an on-disk SQLite file. No account or external service needed.
DATABASE_URI=file:./dawnwalker.db
# For production on Turso/libSQL, swap to the remote URL and set the auth token:
# DATABASE_URI=libsql://your-db.turso.io
# DATABASE_AUTH_TOKEN=

# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=CHANGE_ME

# Public origin, used for canonical URLs, sitemap and OG tags.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# IndexNow pushes new and changed URLs to Bing, Yandex, Seznam, Naver and Yep.
# Google does not participate — for Google, submit the sitemap in Search Console.
#
# A key is already generated and committed as public/<key>.txt. Nothing to set
# up: just deploy, then run `pnpm indexnow --send`. This variable only exists to
# override that key if it is ever rotated.
# INDEXNOW_KEY=


# ---------------------------------------------------------------------------
# Email
# ---------------------------------------------------------------------------
# Nothing below is needed to run the site. Left alone, the provider is
# `console`: every message is printed to the terminal and thrown away, which is
# what a fresh clone with no accounts anywhere should do.
#
# It is also not a working mail setup, and the site will say so — `pnpm
# email:test` exits non-zero on the console provider rather than reporting
# success. Full guide, including what to check when mail stops arriving:
# docs/EMAIL.md
#
# Anything wrong down here stops the app starting, with the variable named. An
# email that vanishes is worse than an app that refuses to boot.

# console (default) | mailgun | resend | smtp
# EMAIL_PROVIDER=console

# Required for every provider except console. It must be an address your email
# provider has verified — usually at the sending domain, not your website — or
# mail is rejected or silently dropped at the far end.
# EMAIL_FROM_ADDRESS=noreply@mg.example.com

# What the network is called in somebody's inbox. Optional; with no name, mail
# goes out from the bare address. Both this and the address can be overridden
# without a redeploy in Admin → Site settings → Legal & contact.
# EMAIL_FROM_NAME=Vellum

# Where a reply goes, if the sending address is a no-reply. Optional.
# EMAIL_REPLY_TO=hello@example.com

# Send every message to this address instead of the real recipient. For a
# staging deployment running against a copy of the live database, where the
# real recipients are real readers. Never set this in production.
# EMAIL_OVERRIDE_RECIPIENT=

# --- Mailgun ---------------------------------------------------------------
# MAILGUN_API_KEY=
# The sending domain from your Mailgun dashboard, e.g. mg.example.com.
# MAILGUN_DOMAIN=
# us (default) or eu. THIS ONE MATTERS: Mailgun runs two separate stacks that
# share no domains and no keys, and an EU domain addressed at the US endpoint
# answers 401 — which reads as a bad key and gets debugged as one. If you
# picked "EU" when creating the domain, say eu here.
# MAILGUN_REGION=us

# --- Resend ----------------------------------------------------------------
# Starts with re_. If yours starts with whsec_ that is the webhook signing
# secret from the next screen along, and the app will refuse to start.
# RESEND_API_KEY=

# --- SMTP ------------------------------------------------------------------
# The escape hatch: SendGrid, Postmark, SES, Zoho, Fastmail, Mailgun's own SMTP
# endpoint, or a relay on your own box. docs/EMAIL.md lists the host and port
# for each.
# SMTP_HOST=smtp.postmarkapp.com
# 587 by default.
# SMTP_PORT=587
# Implicit TLS. Left unset it is derived from the port — true on 465, false
# everywhere else, which is STARTTLS. Set it only for a relay that disagrees;
# `secure=false` against port 465 does not error, it hangs.
# SMTP_SECURE=
# Set both or neither. Neither is an unauthenticated relay, which is a real
# configuration; one without the other is a boot failure, because it is always
# somebody who thinks they set both.
# SMTP_USER=
# SMTP_PASSWORD=
